{
  "tasks": {
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run test/",
    "lint": "deno lint src test && deno check src test",
    "fmt": "deno fmt src test",
    "fmt-check": "deno fmt --check src test",
    "relay": "deno run --allow-net --allow-env src/relay/main.ts",
    "echo-relay": "deno run --allow-net --allow-env src/tools/echo-relay.ts",
    "serve": "deno run --allow-net --allow-read --allow-env src/serve/main.ts",
    "fetch-assets": "deno run --allow-net --allow-read --allow-write src/tools/fetch-assets.ts",
    "patch-check": "deno run --allow-read src/tools/patch-spa-cli.ts check",
    "patch-apply": "deno run --allow-read --allow-write src/tools/patch-spa-cli.ts apply",
    "cache": "deno cache src/relay/main.ts src/serve/main.ts src/tools/fetch-assets.ts test/e2e.test.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/log": "jsr:@std/log@^0.224.14",
    "@std/path": "jsr:@std/path@^1.1.0",
    "hono": "jsr:@hono/hono@^4.13.13",
    "hono/compress": "jsr:@hono/hono@^4.13.13/compress",
    "hono/etag": "jsr:@hono/hono@^4.13.13/etag",
    "@hono/deno": "jsr:@hono/deno@^1.0.3",
    "ws": "npm:ws@^8.18.3",
    "zod": "npm:zod@^4.6.5"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["vendor-assets/", "**/*.md"]
  },
  "lint": {
    "exclude": ["vendor-assets/"]
  }
}
